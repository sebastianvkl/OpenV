{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build:static --prefix web",
  "outputDirectory": "web/dist",
  "routes": [
    {
      "src": "^/api/.*$",
      "methods": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "status": 403,
      "dest": "/recorded/read-only.json"
    },
    {
      "src": "^/api/config$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/recorded/config.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "^/api/runs$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/recorded/runs.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "^/api/runs/([A-Za-z0-9-]+)$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/recorded/runs/$1.json",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "^/artifacts/(.*)$",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/artifacts/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    }
  ]
}
