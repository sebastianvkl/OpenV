OPENAI_API_KEY=
OPENV_MODEL=gpt-6-astra
OPENV_STORE=local
OPENV_ARTIFACTS=artifacts
OPENV_MAX_EXPERIMENTS=5
OPENV_MAX_DAILY_RUNS=20
# Use 1 on a public demo host; 0 permits local engineering runs.
OPENV_READ_ONLY=0
OPENV_RUN_TIMEOUT=1800
DALUS_MCP_URL=https://app.dalus.io/api/mcp
DALUS_TEAM_ID=
OPENV_PUBLIC_URL=

# One persistent engineering model per system; keep the mapping across runs.
# OPENV_DALUS_MAPPING=.openv/dalus-system.json
# OPENV_DALUS_MODEL_ID=existing-model-id
